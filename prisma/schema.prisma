model WardRequest {
  id            String    @id @default(uuid())
  request_no    String    @unique
  department_id String
  requester_id  String
  period_type   String    @default("MONTH")
  period_start  DateTime
  period_end    DateTime
  status        String    @default("DRAFT")
  // DRAFT | SUBMITTED | APPROVED | PARTIAL_APPROVED | REJECTED | CANCELLED
  request_type           String    @default("CONSUMABLE_REGULAR")  // CONSUMABLE_REGULAR | DIAPER | NIGHT_SNACK | ADHOC | EQUIPMENT
