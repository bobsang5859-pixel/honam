model DiseaseCode {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  code_type  String   // MAIN | SEVERE | RARE
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  deleted_at DateTime?

  patient_disease_codes PatientDiseaseCode[]

  @@index([code_type, is_active])
  @@map("disease_codes")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  ?섏옄蹂?V肄붾뱶 ?깅줉 ?대젰
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model PatientDiseaseCode {
  id              String    @id @default(uuid())
  patient_id      String
  disease_code_id String
  registered_at   DateTime
  expires_at      DateTime?
  note            String    @default("")
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  patient      Patient     @relation(fields: [patient_id], references: [id])
  disease_code DiseaseCode @relation(fields: [disease_code_id], references: [id])

  @@index([patient_id])
  @@index([disease_code_id])
  @@map("patient_disease_codes")
}

model WardRoom {
  id            String   @id @default(uuid())
  department_id String
  room_no       String
  capacity      Int      @default(6)
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  deleted_at    DateTime?

  department Department      @relation(fields: [department_id], references: [id])
  boards     WardRoomBoard[]

  @@unique([department_id, room_no])
  @@index([department_id, is_active])
  @@map("ward_rooms")
}

model WardRoomBoard {
  id                     String   @id @default(uuid())
  board_date             DateTime
  department_id          String
  ward_room_id           String
  room_no                String
  bed_no                 Int
  patient_id             String?
  patient_no             String   @default("")
  chart_no               String   @default("")
  patient_name           String   @default("")
  gender                 String   @default("UNKNOWN")
  mobility_type          String   @default("AMBULATORY")
  insurance_type         String   @default("HEALTH")
  specializations        String   @default("[]")
  infection_strain       String   @default("")
  period_type            String   @default("")
  period_phase           String   @default("")
  patient_group          String   @default("UNRATED")
  diaper_state           String   @default("")
  diaper_price           Float?
  diaper_start_date      DateTime?
  diaper_end_date        DateTime?
  prev_hospital          String   @default("")
  acquaintance           String   @default("")
  acquaintance_color     String   @default("")
  status                 String   @default("ADMITTED") // ADMITTED | DISCHARGED | DECEASED
  is_manual              Boolean  @default(false)
  note                   String   @default("")
  main_disease_code_id   String?
  caregiver_type         String   @default("") // CLOSE | OUTSOURCED | IN_HOUSE
  guardian_name          String   @default("")
  billing_sms_phone      String   @default("")
  project_name           String   @default("")
  project_region         String   @default("")
  project_sigungu_office String   @default("")
  address                String   @default("")
  referral_source        String   @default("")
  discharge_type         String   @default("")
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  deleted_at             DateTime?

  department Department @relation(fields: [department_id], references: [id])
  ward_room  WardRoom   @relation(fields: [ward_room_id], references: [id])
  patient    Patient?   @relation(fields: [patient_id], references: [id])

  @@unique([board_date, department_id, ward_room_id, bed_no])
  @@index([department_id, board_date])
  @@index([patient_id, board_date])
  @@map("ward_room_boards")
}

model PatientEvent {
  id            String   @id @default(uuid())
  patient_id    String
  department_id String
  event_type    String // ADMISSION | DISCHARGE | DEATH | TRANSFER
  event_date    DateTime
  room_no       String   @default("")
  bed_no        Int?
  prev_hospital String   @default("")
  memo          String   @default("")
  created_by    String
  created_at    DateTime @default(now())
  deleted_at    DateTime?

