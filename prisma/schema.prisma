model PurchaseOrder {
  id           String    @id @default(uuid())
  po_no        String    @unique
  vendor_id    String
  created_by   String
  status       String    @default("DRAFT")
  // DRAFT | SENT | PARTIAL_RECEIVED | CLOSED | CANCELLED
