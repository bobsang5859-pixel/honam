  stock_in_items StockInItem[]
  inventory_lots InventoryLot[]
  pending_followups PendingReceiptFollowUp[]

  @@index([purchase_order_id, received_at])
  @@index([received_at])
  @@map("goods_receipts")
}

model StockInItem {
  id               String  @id @default(uuid())
  goods_receipt_id String
  item_id          String
  received_qty     Decimal
  expected_qty     Decimal?
  confirmed_qty    Decimal?
  diff_qty         Decimal?
  diff_note        String   @default("")
  confirmed_at     DateTime?
  confirmed_by     String?
  unit_price       Decimal
  location_id      String

  goods_receipt GoodsReceipt      @relation(fields: [goods_receipt_id], references: [id])
  item          Item              @relation(fields: [item_id], references: [id])
  location      InventoryLocation @relation(fields: [location_id], references: [id])
  confirmer     User?             @relation("StockInItemConfirmer", fields: [confirmed_by], references: [id])
  lots          InventoryLot[]

  @@unique([goods_receipt_id, item_id])
  @@index([item_id])
  @@map("stock_in_items")
}

model PendingReceiptFollowUp {
  id                String   @id @default(uuid())
  goods_receipt_id  String
  purchase_order_id String?
  vendor_id         String?
  item_id           String
  missing_qty       Decimal
  status            String   @default("OPEN") // OPEN | RESOLVED | CANCELLED
  note              String   @default("")
  created_at        DateTime @default(now())
  resolved_at       DateTime?
  resolved_by       String?

  goods_receipt  GoodsReceipt  @relation(fields: [goods_receipt_id], references: [id])
  purchase_order PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])
  vendor         Vendor?       @relation(fields: [vendor_id], references: [id])
  item           Item          @relation(fields: [item_id], references: [id])
  resolver       User?         @relation("PendingReceiptFollowUpResolver", fields: [resolved_by], references: [id])

  @@index([goods_receipt_id])
  @@index([purchase_order_id])
  @@index([vendor_id])
  @@index([item_id])
  @@index([status, created_at])
  @@map("pending_receipt_followups")
}

