generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  MASTER: 遺??(怨꾩링 援ъ“)
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model Department {
  id         String    @id @default(uuid())
  code       String    @unique
  name       String
  parent_id  String?
  module_id  String?
  is_active  Boolean   @default(true)
  deleted_at DateTime?

  parent   Department?  @relation("DeptTree", fields: [parent_id], references: [id])
  children Department[] @relation("DeptTree")

  users               User[]
  patient_stats       PatientStat[]
  patients            Patient[]
  ward_requests       WardRequest[]
  stock_outs          StockOut[]
  stock_out_followups StockOutFollowUp[]
  inventory_locations InventoryLocation[]
  category_perms      DeptCategoryPermission[]
  item_perms          DeptItemPermission[]
  ward_rooms          WardRoom[]
  ward_room_boards    WardRoomBoard[]
  patient_events      PatientEvent[]
  dept_calendar_events DeptCalendarEvent[]
  equipment_units      EquipmentUnit[]
  equipment_repairs    EquipmentRepair[]

  @@index([parent_id])
  @@index([is_active])
  @@map("departments")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  AUTH & RBAC
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model User {
  id            String    @id @default(uuid())
  username      String    @unique
  password_hash String
  display_name  String    @default("")
  department_id String?
  is_active      Boolean   @default(true)
  last_login_at  DateTime?
  last_logout_at DateTime? // 서버사이드 로그아웃 무효화: 이 시각 이전 발급 토큰은 authMiddleware에서 거부
  deleted_at        DateTime?
  menu_permissions   String?   // JSON string[] of allowed menu keys. null = default role-based visibility
  direct_permissions String?   // JSON string[] of permission keys directly assigned to user

  department Department? @relation(fields: [department_id], references: [id])

  user_roles       UserRole[]
  ward_requests    WardRequest[]
  approval_actions ApprovalAction[]
  purchase_orders  PurchaseOrder[]
  goods_receipts   GoodsReceipt[]
  confirmed_goods_receipts GoodsReceipt[] @relation("GoodsReceiptConfirmer")
  confirmed_stock_in_items StockInItem[]  @relation("StockInItemConfirmer")
  resolved_followups       PendingReceiptFollowUp[] @relation("PendingReceiptFollowUpResolver")
  created_stock_out_followups StockOutFollowUp[] @relation("StockOutFollowUpCreator")
  resolved_stock_out_followups StockOutFollowUp[] @relation("StockOutFollowUpResolver")
  stock_outs       StockOut[]
  audit_logs       AuditLog[]
  usage_baselines  UsageBaseline[]
  patients         Patient[]
  patient_events   PatientEvent[]
  dept_calendar_events DeptCalendarEvent[]
  patient_payments     PatientPayment[] @relation("PatientPaymentCreator")
  referrals_uploaded   Referral[] @relation("ReferralUploader")
  referrals_approved   Referral[] @relation("ReferralApprover")
  purchase_decisions_created PurchaseDecision[] @relation("PurchaseDecisionCreator")
  proposal_documents_created ProposalDocument[] @relation("ProposalDocumentCreator")
  doc_templates_created      DocTemplate[]      @relation("DocTemplateCreator")
  doc_submissions_generated  DocSubmission[]    @relation("DocSubmissionGenerator")

  @@index([department_id])
  @@index([is_active])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String    @default("")
  deleted_at  DateTime?

  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String @default("")

  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model UserRole {
  user_id String
  role_id String

  user User @relation(fields: [user_id], references: [id])
  role Role @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
  @@index([role_id])
  @@map("user_roles")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  MASTER: ?낆껜
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model Vendor {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  phone          String    @default("")
  email          String    @default("")
  lead_time_days Int       @default(3)
  is_active      Boolean   @default(true)
  deleted_at     DateTime?

  item_defaults   Item[]          @relation("ItemDefaultVendor")
  vendor_maps     ItemVendorMap[]
  price_history   PriceHistory[]
  purchase_orders PurchaseOrder[]
  pending_receipt_followups PendingReceiptFollowUp[]
  inventory_lots  InventoryLot[]
  goods_receipts_manual GoodsReceipt[] @relation("GoodsReceiptManualVendor")
  purchase_decisions PurchaseDecision[]
  external_records ExternalPurchaseRecord[]

  @@map("vendors")
}

// 외부 거래 이력 — 시스템 도입 전 또는 외부 거래원장/매출내역으로 입수한 거래 기록.
// 단가/수량 보존이 목적이며 inventory/lot 흐름에는 영향 없음 (별도 통계용).
model ExternalPurchaseRecord {
  id               String   @id @default(uuid())
  item_id          String
  vendor_id        String
  source_label     String                   // '예스상사_매출내역' | '기저귀_거래원장' 등
  transaction_date DateTime
  qty              Decimal                  // 외부 단위 기준 수량
  unit_label       String   @default("")    // 외부 단위 표기 (박스/봉지/ea 등)
  unit_price       Decimal                  // 원 단위
  amount           Decimal                  // 거래 금액 (보통 qty * unit_price)
  external_name    String   @default("")    // 외부 표기 품명 (참고용 — 시스템 품명과 다를 수 있음)
  note             String   @default("")
  created_at       DateTime @default(now())

  item   Item   @relation(fields: [item_id], references: [id])
  vendor Vendor @relation(fields: [vendor_id], references: [id])

  @@index([item_id, transaction_date])
  @@index([vendor_id, transaction_date])
  @@map("external_purchase_records")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  MASTER: ?덈ぉ
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model Item {
  id                     String    @id @default(uuid())
  item_code              String    @unique
  name                   String
  category               String    @default("MED_OTHER")  // 중분류 — CATEGORY_HIERARCHY + EQUIPMENT_CATEGORIES 참조 (shared/types.ts). 통계 그룹은 prefix 로 자동 도출 (getStatsGroup)
  sub_category           String    @default("")             // 소분류 (선택) — 중분류별로 추가 세분화가 필요할 때 사용
  expense_scope          String    @default("PATIENT_DIRECT") // PATIENT_DIRECT | OPS_INDIRECT
  uom                    String    @default("EA")              // @deprecated — purchase_uom/issue_uom 사용. 호환성 위해 유지
  purchase_uom           String    @default("EA")              // 발주 단위 (예: 박스). PO·입고·단가는 이 단위 기준
  issue_uom              String    @default("EA")              // 불출/재고 단위 (예: 개). 재고·부서신청·불출은 이 단위 기준
  pack_size              Int       @default(1)                 // 1 purchase_uom = pack_size issue_uom (양의 정수)
  default_vendor_id      String?
  default_treatment_type_id String?
  // 병동(부서)에 한해 기저귀 신청 화면에도 노출 + 일반소모품 신청에서는 숨김 (예: 물티슈)
  // 다른 부서(원무·약제 등)에게는 기존 카테고리대로 일반소모품에서 보임
  diaper_companion_for_wards Boolean @default(false)
  min_order_qty          Int       @default(1)
  is_regular_order       Boolean   @default(true)
  reorder_days_threshold Int       @default(7)
  is_active              Boolean   @default(true)
  deleted_at             DateTime?
  image_url              String?

  default_vendor        Vendor?              @relation("ItemDefaultVendor", fields: [default_vendor_id], references: [id])
  default_treatment     TreatmentType?       @relation("ItemDefaultTreatment", fields: [default_treatment_type_id], references: [id])
  vendor_maps           ItemVendorMap[]
  price_history         PriceHistory[]
  external_records      ExternalPurchaseRecord[]
  ward_request_items    WardRequestItem[]
  approval_action_items ApprovalActionItem[]
  purchase_order_items  PurchaseOrderItem[]
  stock_in_items        StockInItem[]
  stock_out_items       StockOutItem[]
  inventory             Inventory[]
  pending_receipt_followups PendingReceiptFollowUp[]
  stock_out_followups      StockOutFollowUp[]
  inventory_lots        InventoryLot[]
  usage_baselines       UsageBaseline[]
  dept_item_permissions DeptItemPermission[]
  equipment_units       EquipmentUnit[]
  treatment_supply_maps TreatmentSupplyMap[]
  units_per_pack_history ItemUnitsPerPack[]

  @@index([category])
  @@index([expense_scope])
  @@index([default_vendor_id])
  @@index([default_treatment_type_id])
  @@index([is_regular_order])
  @@map("items")
}

// 품목 「팩당 장수」 시점별 이력.
// 통계(예: 기저귀 사용량)에서 출고 시점에 effective 인 값으로 환산.
// 같은 item_id 라도 effective_from 이 다른 여러 행 = 시간이 지나며 변경된 값들.
// 룩업 규칙: 어떤 시점 t 에 적용되는 값 = item_id 의 effective_from <= t 중 가장 최근 행.
model ItemUnitsPerPack {
  id              String   @id @default(uuid())
  item_id         String
  units_per_pack  Int
  effective_from  DateTime
  note            String   @default("")
  created_by      String?
  created_at      DateTime @default(now())

  item Item @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id, effective_from])
  @@map("item_units_per_pack_history")
}

model ItemVendorMap {
  id        String  @id @default(uuid())
  item_id   String
  vendor_id String
  priority  Int     @default(1)
  is_active Boolean @default(true)

  item   Item   @relation(fields: [item_id], references: [id])
  vendor Vendor @relation(fields: [vendor_id], references: [id])

  @@unique([item_id, vendor_id])
  @@map("item_vendor_map")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  媛寃??대젰
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model PriceHistory {
  id             String    @id @default(uuid())
  item_id        String
  vendor_id      String
  price          Decimal
  currency       String    @default("KRW")
  effective_from DateTime
  effective_to   DateTime?
  source         String    @default("MANUAL")  // PO | MANUAL | CONTRACT
  created_at     DateTime  @default(now())

  item   Item   @relation(fields: [item_id], references: [id])
  vendor Vendor @relation(fields: [vendor_id], references: [id])

  @@unique([item_id, vendor_id, effective_from])
  @@index([item_id, vendor_id])
  @@map("price_history")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  ?섏옄 ?듦퀎 (湲곌컙蹂?
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model PatientStat {
  id                  String    @id @default(uuid())
  department_id       String
  period_type         String    // DAY | WEEK | MONTH
  period_start        DateTime
  period_end          DateTime
  patient_count       Int
  created_at          DateTime  @default(now())
  deleted_at          DateTime?

  department Department @relation(fields: [department_id], references: [id])

  @@unique([department_id, period_type, period_start])
  @@index([department_id, period_start])
  @@map("patient_stats")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  ?섏옄 愿由?(媛쒕퀎 ?낇눜??
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model Patient {
  id                        String    @id @default(uuid())
  patient_no                String    @default("")
  chart_no                  String    @default("")
  name                      String    @default("")
  department_id             String
  room_no                   String    @default("")
  bed_no                    Int?
  gender                    String    @default("UNKNOWN") // F | M | UNKNOWN
  mobility_type             String    @default("AMBULATORY") // BEDRIDDEN | AMBULATORY
  insurance_type            String    @default("HEALTH") // HEALTH | MEDICAL_1 | MEDICAL_2 | WORKERS_COMP | AUTO_INS
  copay_reduction           String    @default("NONE") // NONE | SEVERE(중증질환) | RARE(희귀난치성)
  patient_group             String    @default("UNRATED") // HIGHEST | HIGH | MEDIUM | LOW | SELECT | UNRATED | PNEUMONIA | SEPSIS (PNEUMONIA/SEPSIS 선택 시 period_type 자동 동기화)
  specializations           String    @default("[]") // JSON string: INFECT | DIALYSIS | REHAB
  infection_strain          String    @default("") // CRE | VRE | MR | ''
  period_type               String    @default("") // PNEUMONIA | SEPSIS | ''
  period_phase              String    @default("") // START | END | ''
  diaper_state              String    @default("NONE") // IN_HOUSE | PERSONAL | NONE — 빈 문자열 금지 (referral 등 normalize 우회 경로 방어)
  diaper_price              Float?
  diaper_start_date         DateTime?
  diaper_end_date           DateTime?
  prev_hospital             String    @default("")
  acquaintance              String    @default("")
  acquaintance_color        String    @default("")
  deceased_at               DateTime?
  admitted_at               DateTime  @default(now())
  discharged_at             DateTime?
  status                    String    @default("ADMITTED") // ADMITTED | DISCHARGED | DECEASED
  note                      String    @default("")
  created_by                String
  created_at                DateTime  @default(now())
  deleted_at                DateTime?
  disease_code_id           String?   // active V code id
  disease_code_registered_at DateTime?
  disease_code_expires_at   DateTime?
  main_disease_code_id      String?
  caregiver_type            String    @default("") // CLOSE | OUTSOURCED | IN_HOUSE
  guardian_name             String    @default("")
  billing_sms_phone         String    @default("")
  project_name              String    @default("")
  project_region            String    @default("")
  project_sigungu_office    String    @default("")
  address                   String    @default("")
  referral_source           String    @default("")
  discharge_type            String    @default("")
  monthly_medical_fee       Float     @default(0)
  monthly_payment           Float     @default(0)
  monthly_unpaid            Float     @default(0)
  rehab_type                String    @default("") // CNS(뇌신경계 재활) | OS(정형외과·기타 재활) | OUTPATIENT(외래) | '' (해당없음)
  onset_date                DateTime?            // 발병일 (재활 환자) — onset 경과 기간으로 수가 단계 결정

  department            Department         @relation(fields: [department_id], references: [id])
  creator               User               @relation(fields: [created_by], references: [id])
  room_boards           WardRoomBoard[]
  events                PatientEvent[]
  patient_disease_codes PatientDiseaseCode[]
  patient_treatments    PatientTreatment[]
  patient_item_usage    PatientItemUsage[] @relation("PatientItemUsage")
  charges               PatientCharge[]
  payments              PatientPayment[]
  referrals             Referral[]

  @@index([department_id, status])
  @@index([department_id, room_no, bed_no])
  @@index([admitted_at])
  @@index([rehab_type])
  @@map("patients")
}

