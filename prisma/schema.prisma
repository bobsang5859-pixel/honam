model Inventory {
  id            String    @id @default(uuid())
  item_id       String
  location_id   String
  on_hand_qty   Decimal   @default(0)
  avg_unit_cost Decimal   @default(0)
  updated_at    DateTime  @updatedAt

  item     Item              @relation(fields: [item_id], references: [id])
  location InventoryLocation @relation(fields: [location_id], references: [id])

  @@unique([item_id, location_id])
  @@index([item_id, location_id])
  @@map("inventory")
}

model InventoryLot {
  id              String    @id @default(uuid())
  stock_in_item_id String
  goods_receipt_id String
  item_id         String
  location_id     String
  vendor_id       String?
  received_at     DateTime
  unit_cost       Decimal   @default(0)
  received_qty    Decimal   @default(0)
  remaining_qty   Decimal   @default(0)
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  stock_in_item StockInItem        @relation(fields: [stock_in_item_id], references: [id])
