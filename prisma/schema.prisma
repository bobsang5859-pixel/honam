  requester  User       @relation(fields: [requester_id], references: [id])

  items            WardRequestItem[]
  approval_actions ApprovalAction[]
  stock_outs       StockOut[]
  po_sources       PurchaseOrderSource[]

  @@index([department_id, submitted_at])
  @@index([status])
  @@index([is_emergency])
  @@map("ward_requests")
}

