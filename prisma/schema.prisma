model InventoryLocation {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String
  department_id    String?
  is_active        Boolean   @default(true)
  // 재고자산(Asset) 합산 대상 여부 — true: 자산 통계 포함 (총무구매 창고 등), false: 자산 미인식 (부서 보관함 — 비용은 출고 시점 인식)
  is_asset_tracked Boolean   @default(true)
  deleted_at       DateTime?

  department      Department?    @relation(fields: [department_id], references: [id])
  inventory       Inventory[]
  stock_in_items  StockInItem[]
  stock_out_items StockOutItem[]
  inventory_lots  InventoryLot[]

  @@map("inventory_locations")
}

model Inventory {
  id            String    @id @default(uuid())
  item_id       String
  location_id   String
  on_hand_qty   Decimal   @default(0)
  avg_unit_cost Decimal   @default(0)
  updated_at    DateTime  @updatedAt

  item     Item              @relation(fields: [item_id], references: [id])
  location InventoryLocation @relation(fields: [location_id], references: [id])

  @@unique([item_id, location_id])
  @@index([item_id, location_id])
  @@map("inventory")
}

model InventoryLot {
  id              String    @id @default(uuid())
  stock_in_item_id String
  goods_receipt_id String
  item_id         String
  location_id     String
  vendor_id       String?
  received_at     DateTime
  unit_cost       Decimal   @default(0)
  received_qty    Decimal   @default(0)
  remaining_qty   Decimal   @default(0)
  // 사용자 지정 출고 우선순위 — 0 = 자동(FIFO, received_at 순). 양수 = 명시 우선순위(작을수록 먼저).
  sort_order      Int       @default(0)
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  stock_in_item StockInItem        @relation(fields: [stock_in_item_id], references: [id])
  goods_receipt GoodsReceipt       @relation(fields: [goods_receipt_id], references: [id])
  item         Item                @relation(fields: [item_id], references: [id])
  location     InventoryLocation   @relation(fields: [location_id], references: [id])
  vendor       Vendor?             @relation(fields: [vendor_id], references: [id])
  allocations  StockOutLotAllocation[]

  @@unique([stock_in_item_id])
  @@index([item_id, location_id, received_at])
  @@index([vendor_id])
  @@map("inventory_lots")
}

model StockOutLotAllocation {
  id              String    @id @default(uuid())
  stock_out_id    String
  stock_out_item_id String
  inventory_lot_id String?
  issued_qty      Decimal   @default(0)
  unit_cost       Decimal   @default(0)
  line_amount     Decimal   @default(0)
  created_at      DateTime  @default(now())

  stock_out     StockOut    @relation(fields: [stock_out_id], references: [id])
  stock_out_item StockOutItem @relation(fields: [stock_out_item_id], references: [id])
  inventory_lot  InventoryLot? @relation(fields: [inventory_lot_id], references: [id])

  @@index([stock_out_id])
  @@index([stock_out_item_id])
  @@index([inventory_lot_id])
  @@map("stock_out_lot_allocations")
}

