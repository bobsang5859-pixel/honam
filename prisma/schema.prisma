model PurchaseOrder {
  id           String    @id @default(uuid())
  po_no        String    @unique
  vendor_id    String
  created_by   String
  status       String    @default("DRAFT")
  // DRAFT | SENT | PARTIAL_RECEIVED | CLOSED | CANCELLED
  ordered_at   DateTime  @default(now())
  expected_at  DateTime?
  pdf_path     String    @default("")
  total_amount Decimal   @default(0)
  note         String    @default("")
  is_test      Boolean   @default(false)  // 테스트 데이터 (parent 신청이 test이면 자동 전파)
  // 주차 라벨 수동 지정 (신청 기반 schedule_period_label 보다 우선). 그룹화 이동용.
  manual_period_label String?
  deleted_at   DateTime?

  vendor   Vendor             @relation(fields: [vendor_id], references: [id])
  creator  User               @relation(fields: [created_by], references: [id])
  po_items PurchaseOrderItem[]
  receipts GoodsReceipt[]
  pending_receipt_followups PendingReceiptFollowUp[]
  sources  PurchaseOrderSource[]
  from_decision PurchaseDecision? @relation("PurchaseDecisionUsedInPo")

  @@index([vendor_id, ordered_at])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  purchase_order_id String
  item_id           String
  ordered_qty       Decimal
  unit_price        Decimal
  line_amount       Decimal

  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  item           Item          @relation(fields: [item_id], references: [id])

  @@unique([purchase_order_id, item_id])
  @@index([item_id])
  @@map("purchase_order_items")
}

// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
//  ?낃퀬 (Goods Receipt)
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model GoodsReceipt {
  id                String    @id @default(uuid())
  gr_no             String    @unique
  purchase_order_id String?
  // 발주서 미연결(수기 입고) 시 사용자가 직접 지정하는 거래처. 발주서 연결 시에는 purchase_order.vendor_id 사용.
  manual_vendor_id  String?
  received_by       String
  received_at       DateTime  @default(now())
  status            String    @default("PENDING")  // PENDING | CONFIRMED | DIFF_CONFIRMED | REVERSED
  note              String    @default("")
  confirmed_at      DateTime?
  confirmed_by      String?
  diff_count        Int       @default(0)
  is_test           Boolean   @default(false)  // 테스트 데이터 (parent PO가 test이면 자동 전파)
  deleted_at        DateTime?
  // 절사·할인 등 GR 단위 조정 금액 (양수 = 차감액). 라인 단위가 아닌 GR 전체 조정 — 품목 마스터 오염 방지.
  adjustment_amount Decimal   @default(0)
  adjustment_note   String    @default("")  // 절사 사유 (예: "현금할인", "원단위절사")

  purchase_order PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])
  manual_vendor  Vendor?        @relation("GoodsReceiptManualVendor", fields: [manual_vendor_id], references: [id])
  receiver       User           @relation(fields: [received_by], references: [id])
  confirmer      User?          @relation("GoodsReceiptConfirmer", fields: [confirmed_by], references: [id])
  stock_in_items StockInItem[]
  inventory_lots InventoryLot[]
  pending_followups PendingReceiptFollowUp[]

  @@index([purchase_order_id, received_at])
  @@index([received_at])
  @@map("goods_receipts")
}

model StockInItem {
  id               String  @id @default(uuid())
  goods_receipt_id String
  item_id          String
  received_qty     Decimal
  expected_qty     Decimal?
  confirmed_qty    Decimal?
  diff_qty         Decimal?
  diff_note        String   @default("")
  confirmed_at     DateTime?
  confirmed_by     String?
  unit_price       Decimal
  location_id      String

  goods_receipt GoodsReceipt      @relation(fields: [goods_receipt_id], references: [id])
  item          Item              @relation(fields: [item_id], references: [id])
  location      InventoryLocation @relation(fields: [location_id], references: [id])
  confirmer     User?             @relation("StockInItemConfirmer", fields: [confirmed_by], references: [id])
  lots          InventoryLot[]

  @@unique([goods_receipt_id, item_id])
  @@index([item_id])
  @@map("stock_in_items")
}

model PendingReceiptFollowUp {
  id                String   @id @default(uuid())
  goods_receipt_id  String
  purchase_order_id String?
  vendor_id         String?
  item_id           String
  missing_qty       Decimal
  status            String   @default("OPEN") // OPEN | RESOLVED | CANCELLED
  note              String   @default("")
  created_at        DateTime @default(now())
  resolved_at       DateTime?
  resolved_by       String?

  goods_receipt  GoodsReceipt  @relation(fields: [goods_receipt_id], references: [id])
  purchase_order PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])
  vendor         Vendor?       @relation(fields: [vendor_id], references: [id])
  item           Item          @relation(fields: [item_id], references: [id])
  resolver       User?         @relation("PendingReceiptFollowUpResolver", fields: [resolved_by], references: [id])

  @@index([goods_receipt_id])
  @@index([purchase_order_id])
  @@index([vendor_id])
  @@index([item_id])
  @@index([status, created_at])
  @@map("pending_receipt_followups")
}

