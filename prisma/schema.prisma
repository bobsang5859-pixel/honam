  location     InventoryLocation   @relation(fields: [location_id], references: [id])
  vendor       Vendor?             @relation(fields: [vendor_id], references: [id])
  allocations  StockOutLotAllocation[]

  @@unique([stock_in_item_id])
  @@index([item_id, location_id, received_at])
  @@index([vendor_id])
  @@map("inventory_lots")
}

model StockOutLotAllocation {
  id              String    @id @default(uuid())
  stock_out_id    String
  stock_out_item_id String
  inventory_lot_id String?
  issued_qty      Decimal   @default(0)
  unit_cost       Decimal   @default(0)
  line_amount     Decimal   @default(0)
  created_at      DateTime  @default(now())

  stock_out     StockOut    @relation(fields: [stock_out_id], references: [id])
  stock_out_item StockOutItem @relation(fields: [stock_out_item_id], references: [id])
  inventory_lot  InventoryLot? @relation(fields: [inventory_lot_id], references: [id])

  @@index([stock_out_id])
  @@index([stock_out_item_id])
  @@index([inventory_lot_id])
  @@map("stock_out_lot_allocations")
}

