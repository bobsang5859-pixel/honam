//  遺덉텧 (Stock Out)
// ?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧?먥븧
model StockOut {
  id              String    @id @default(uuid())
  so_no           String    @unique
  department_id   String
  ward_request_id String?
  issued_by       String
  issued_at       DateTime  @default(now())
  status          String    @default("RECEIPT_PENDING")  // RECEIPT_PENDING | RECEIPT_CONFIRMED | RECEIPT_DIFF | REVERSED
  note            String    @default("")
  receipt_confirmed_at DateTime?
  receipt_confirmed_by String?
  receipt_diff_count   Int      @default(0)
  // 수기불출 자동확정 OR 총무구매 「대신 확정」 으로 부서 수령검수 없이 확정된 건 표시
  confirmed_by_purchaser Boolean @default(false)
  is_test         Boolean   @default(false)  // 테스트 데이터 (parent ward request 또는 lot이 test이면 자동 전파)
  // ADHOC 등 ward_request 가 없는 불출을 특정 주차로 그룹화하기 위한 수동 라벨.
  // null 이면 ward_request 의 라벨 또는 "기간 미지정" 그룹.
  manual_period_label String?
  deleted_at      DateTime?

  department   Department   @relation(fields: [department_id], references: [id])
  ward_request WardRequest? @relation(fields: [ward_request_id], references: [id])
  issuer       User         @relation(fields: [issued_by], references: [id])
  items        StockOutItem[]
  lot_allocations StockOutLotAllocation[]
  follow_ups   StockOutFollowUp[]

  @@index([department_id, issued_at])
  @@index([ward_request_id])
  @@map("stock_out")
}

model StockOutFollowUp {
  id            String   @id @default(uuid())
  stock_out_id  String
  department_id String
  item_id       String
  action_type   String   // ISSUE_ADD | COLLECT_BACK
  diff_qty      Decimal
  status        String   @default("OPEN") // OPEN | RESOLVED | CANCELLED
  // 관리자가 고른 처리방식 (status=RESOLVED 시 기록). null = 아직 미결정.
  //   ISSUED_EXTRA        : 추가불출 실행 (부족분 추가 출고 — 재고 차감 + 비용 추가)
  //   NOT_ISSUED_RETURNED : 추가불출 안 함 + 부족분 창고 잔류 → 창고 재고/lot 복원 + 비용 정정
  //   NOT_ISSUED_LOST     : 추가불출 안 함 + 부족분 분실/파손 → 비용만 정정 (창고 복원 없음)
  //   COLLECTED           : 회수 실행 (창고 재고/lot 환입 + 원 출고 lot 원가로 비용 차감)
  //   NOT_COLLECTED       : 회수 안 함 (부서가 그대로 사용 — 변동 없음)
  disposition   String?
  note          String   @default("")
  created_at    DateTime @default(now())
  created_by    String
  resolved_at   DateTime?
  resolved_by   String?

  stock_out   StockOut   @relation(fields: [stock_out_id], references: [id])
  department  Department @relation(fields: [department_id], references: [id])
  item        Item       @relation(fields: [item_id], references: [id])
  creator     User       @relation("StockOutFollowUpCreator", fields: [created_by], references: [id])
  resolver    User?      @relation("StockOutFollowUpResolver", fields: [resolved_by], references: [id])

  @@index([status, created_at])
  @@index([department_id, status])
  @@index([stock_out_id])
  @@index([item_id])
  @@map("stock_out_followups")
}

model StockOutItem {
  id           String  @id @default(uuid())
  stock_out_id String
  item_id      String
  issued_qty   Decimal
  location_id  String
  received_qty         Decimal?
  receipt_note         String   @default("")
  receipt_confirmed_at DateTime?
  receipt_confirmed_by String?

  stock_out StockOut          @relation(fields: [stock_out_id], references: [id])
  item      Item              @relation(fields: [item_id], references: [id])
  location  InventoryLocation @relation(fields: [location_id], references: [id])
  allocations StockOutLotAllocation[]

  @@unique([stock_out_id, item_id])
  @@index([item_id])
  @@map("stock_out_items")
}

