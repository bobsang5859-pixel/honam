model GoodsReceipt {
  id                String    @id @default(uuid())
  gr_no             String    @unique
  purchase_order_id String?
  received_by       String
  received_at       DateTime  @default(now())
  status            String    @default("PENDING")  // PENDING | CONFIRMED | DIFF_CONFIRMED | REVERSED
  note              String    @default("")
  confirmed_at      DateTime?
  confirmed_by      String?
  diff_count        Int       @default(0)
  deleted_at        DateTime?

  purchase_order PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])
