  start_time      String?                           // "09:00" 24h format (optional)
  end_time        String?                           // "10:30" 24h format (optional)
  created_by      String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  department Department @relation(fields: [department_id], references: [id])
  creator    User       @relation(fields: [created_by], references: [id])

  @@index([department_id, event_date])
  @@map("dept_calendar_events")
}

// ────────────────────────────────────────────────────────────────
//  관리과 모듈
// ────────────────────────────────────────────────────────────────

// ── 비품 개별 단위 추적 ──────────────────────────────────────────
model EquipmentUnit {
  id             String   @id @default(uuid())
  serial_no      String   @unique       // EQ-2026-00001
  item_id        String
  department_id  String
  stock_out_id   String?               // 어느 불출에서 생성됐는지
  location       String   @default("") // 위치 (예: 2병동 간호스테이션)
  is_primary     Boolean  @default(true) // 정(true) / 부(false)
  status         String   @default("ACTIVE") // ACTIVE | IN_REPAIR | DISPOSED
  notes          String   @default("")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  item        Item        @relation(fields: [item_id], references: [id])
  department  Department  @relation(fields: [department_id], references: [id])
  repairs     EquipmentRepair[]

  @@index([department_id])
  @@index([status])
  @@map("equipment_units")
}

// ── 비품 수리 요청/이력 ──────────────────────────────────────────
model EquipmentRepair {
  id                       String   @id @default(uuid())
  equipment_unit_id        String
  requesting_dept_id       String
  description              String   @default("")
  attachment_urls          String   @default("[]")  // JSON
  status                   String   @default("PENDING")
  // PENDING | IN_PROGRESS | COMPLETED | DISPOSED
  result_note              String   @default("")
  disposal_ward_request_id String?  // 수리불가 폐기 시 자동 생성된 WardRequest ID
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  equipment_unit    EquipmentUnit @relation(fields: [equipment_unit_id], references: [id])
  requesting_dept   Department    @relation(fields: [requesting_dept_id], references: [id])

  @@index([equipment_unit_id])
  @@index([status])
  @@map("equipment_repairs")
}

// ═══════════════════════════════════════════════════
//  처치 기반 물품 추적 (Treatment-Based Supply Tracking)
// ═══════════════════════════════════════════════════
model TreatmentType {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  category   String   @default("")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  supply_maps        TreatmentSupplyMap[]
  patient_treatments PatientTreatment[]
  item_defaults      Item[]               @relation("ItemDefaultTreatment")

  @@map("treatment_types")
}

model PatientTreatment {
  id                String    @id @default(uuid())
  patient_id        String
  treatment_type_id String
  started_at        DateTime  @default(now())
  ended_at          DateTime?
  note              String    @default("")
  created_by        String
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  patient        Patient       @relation(fields: [patient_id], references: [id])
  treatment_type TreatmentType @relation(fields: [treatment_type_id], references: [id])

  @@unique([patient_id, treatment_type_id, started_at])
  @@index([patient_id])
  @@map("patient_treatments")
}

// 환자×품목 사용 매핑 — 호흡·삽관, 카테터·튜브 같이 환자 임상 상태 단위로 추적되는 품목용.
// 기저귀(Patient.diaper_state)와 처치 등록(PatientTreatment + TreatmentSupplyMap) 의 보완.
//
// usage_kind: AIRWAY_INTUBATION / AIRWAY_CANNULA / CATH_FOLEY / CATH_URINBAG / CATH_SUCTION / CATH_CONNECTOR / CATH_LEVIN
// group_key:  같은 환자 매핑을 공유하는 묶음. 예) FOLEY_GROUP(폴리·유린백), SUCTION_GROUP(석션·커넥터), 그 외는 usage_kind 자체.
// size:       Item.sub_category 에서 가져온 사이즈/규격 (예: '14Fr', 'Y-Type'). 없으면 빈 문자열.
model PatientItemUsage {
  id           String    @id @default(uuid())
  patient_id   String
  usage_kind   String
  size         String    @default("")
  group_key    String
  started_at   DateTime  @default(now())
  ended_at     DateTime?
  created_by   String
  note         String    @default("")

  patient Patient @relation("PatientItemUsage", fields: [patient_id], references: [id])

  @@unique([patient_id, usage_kind, size])
  @@index([usage_kind, size])
  @@index([group_key, patient_id])
  @@map("patient_item_usage")
}

model TreatmentSupplyMap {
  id                String  @id @default(uuid())
  treatment_type_id String
  item_id           String
  qty_per_day       Decimal @default(1)
  qty_per_week      Decimal @default(0)
  note              String  @default("")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  treatment_type TreatmentType @relation(fields: [treatment_type_id], references: [id])
  item           Item          @relation(fields: [item_id], references: [id])

  @@unique([treatment_type_id, item_id])
  @@map("treatment_supply_maps")
}

model PatientCharge {
  id           String    @id @default(uuid())
  patient_id   String
  category     String    // COVERED(급여) | NON_COVERED(비급여)
  item_name    String    // 임종실, 기저귀, 영양제 등
  amount       Float     @default(0)
  charge_month String    // "2026-03" 형식
  note         String    @default("")
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  patient Patient @relation(fields: [patient_id], references: [id])

  @@index([patient_id, charge_month])
  @@index([category, charge_month])
  @@map("patient_charges")
}

model PatientPayment {
  id              String    @id @default(uuid())
  patient_id      String
  amount          Float
  payment_date    DateTime
  payment_method  String    // CASH | CARD | TRANSFER | OTHER
  charge_month    String    // "2026-03"
  note            String    @default("")
  created_by      String
  created_at      DateTime  @default(now())
  deleted_at      DateTime?

  patient Patient @relation(fields: [patient_id], references: [id])
  creator User    @relation("PatientPaymentCreator", fields: [created_by], references: [id])

  @@index([patient_id, charge_month])
  @@index([charge_month])
  @@map("patient_payments")
}

model Referral {
  id                 String    @id @default(uuid())
  status             String    @default("UPLOADED") // UPLOADED | ANALYZING | REVIEW | APPROVED | REJECTED
  file_path          String
  file_name          String
  mime_type          String    @default("image/jpeg")
  memo               String    @default("")
  uploaded_by        String

  patient_name       String    @default("")
  diagnosis          String    @default("")
  condition          String    @default("")
  admission_possible Boolean   @default(false)
  ai_summary         String    @default("")
  suggested_ward     String    @default("")
  suggested_room     String    @default("")
  room_reason        String    @default("")

  final_ward         String    @default("")
  final_room         String    @default("")
  approved_by        String?
  approved_at        DateTime?
  reject_reason      String    @default("")

  patient_id         String?

  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  uploader User     @relation("ReferralUploader", fields: [uploaded_by], references: [id])
  approver User?    @relation("ReferralApprover", fields: [approved_by], references: [id])
  patient  Patient? @relation(fields: [patient_id], references: [id])

  @@index([status])
  @@index([created_at])
  @@map("referrals")
}

// 구매결의서 — 결재용 서류. 시스템엔 결재 흐름 없이 단순 작성·저장·인쇄만.
// 한 결의서 = 한 거래처. 발주에 한 번 사용되면 잠금 (used_in_po_id).
model PurchaseDecision {
  id              String    @id @default(uuid())
  decision_no     String    @unique                        // PD-202605-00001
  title           String    @default("")                   // 사용자 정의 제목
  vendor_id       String                                   // 거래처
  doc_date        DateTime  @default(now())                // 작성 일자
  period_label    String    @default("")                   // "5월 1주" 등
  period_from     DateTime?                                // 물품 사용 시작
  period_to       DateTime?                                // 물품 사용 종료
  dept_label      String    @default("")                   // 청구부서 라벨 ("의료부" 등)
  approver_lines  String    @default("[]")                 // JSON: ["담당","부서장","행정원장","상임이사","이사장"]
  comment         String    @default("")                   // 비고
  items_json      String    @default("[]")                 // 본문 라인 스냅샷 (JSON 배열) — {item_id?, name, spec, qty, unit_price, dept_breakdown?}
  excluded_items_json String @default("[]")                 // X 로 뺀 라인 — {item_id, name, source_wr_ids, removed_at, reason}. from-approved 의 used_pairs 계산에 포함 → 다음 신규작성 시 또 등장 X
  source_po_ids   String    @default("[]")                 // JSON: 결의서 작성 시 모은 PO ID 들 (참고용)
  source_ward_request_ids String @default("[]")            // JSON: 결의서가 묶은 ward_request ID 들 (자동 prefill 시 중복 방지)
  used_in_po_id   String?   @unique                        // 발주에 사용되면 그 PO ID. null = 미사용 (재사용 가능)
  status          String    @default("DRAFT")              // DRAFT | LOCKED (LOCKED = 발주에 사용됨)
  created_by      String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  vendor      Vendor         @relation(fields: [vendor_id], references: [id])
  creator     User           @relation("PurchaseDecisionCreator", fields: [created_by], references: [id])
  used_in_po  PurchaseOrder? @relation("PurchaseDecisionUsedInPo", fields: [used_in_po_id], references: [id])

  @@index([vendor_id])
  @@index([created_at])
  @@map("purchase_decisions")
}

// 기안서 — 결재용 상위 서류. 작성된 구매결의서 1개 이상 묶어서 만듦.
model ProposalDocument {
  id              String    @id @default(uuid())
  document_no     String    @unique                        // PR-202605-00001
  title           String    @default("")
  doc_date        DateTime  @default(now())
  reason          String    @default("")                   // 기안 사유 / 본문
  approver_lines  String    @default("[]")                 // JSON: 결재 라인 라벨
  decision_ids    String    @default("[]")                 // JSON: PurchaseDecision.id 배열
  comment         String    @default("")
  created_by      String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  creator User @relation("ProposalDocumentCreator", fields: [created_by], references: [id])

  @@index([created_at])
  @@map("proposal_documents")
}

// ── 문서자동화 엔진(회사양식 업로드→필드매핑→생성) ──────────────────
// 회사양식 파일(엑셀/HWPX)을 등록하고, 필드 매핑·조건 규칙을 관리자 화면에서
// 코드 수정 없이 설정할 수 있도록 하는 범용 템플릿 레지스트리.
model DocTemplate {
  id                String    @id @default(uuid())
  name              String                                   // 관리용 표시명 ("구매결의서 기본양식")
  doc_type          String                                   // 소비자 매핑 키: "PURCHASE_DECISION" | "GIAN" 등
  format            String                                   // "EXCEL" | "HWPX"
  description       String    @default("")
  master_file_path  String                                   // 원본 양식 파일 경로
  field_schema_json String    @default("[]")                 // FieldDef[] — key/label/type/source(DB_BOUND|MANUAL)/bind_path?
  section_keys_json String    @default("[]")                 // [SECTION:키] 마커 목록(HWPX)
  table_binding_json String   @default("{}")                 // 반복 표 바인딩 정의(테이블 키 → 컬럼 매핑)
  default_visible_sections_json String @default("[]")        // 규칙 없을 때 기본 노출 섹션
  version           Int       @default(1)
  is_active         Boolean   @default(true)
  created_by        String
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  creator     User              @relation("DocTemplateCreator", fields: [created_by], references: [id])
  rules       DocTemplateRule[]
  submissions DocSubmission[]

  @@index([doc_type])
  @@map("doc_templates")
}

// 조건(규칙) 정의 — IF condition THEN action. 코드 수정 없이 관리 화면에서 CRUD.
model DocTemplateRule {
  id                  String    @id @default(uuid())
  template_id         String
  name                String    @default("")
  priority            Int       @default(0)                  // 낮은 값 먼저 평가
  condition_json      String    @default("{}")                // Condition JSON(all/any/not/field-op-value)
  action_type         String                                  // SHOW_FIELD|HIDE_FIELD|SHOW_SECTION|HIDE_SECTION|ADD_TABLE_ROWS
  action_payload_json String    @default("{}")
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  template DocTemplate @relation(fields: [template_id], references: [id])

  @@index([template_id])
  @@map("doc_template_rules")
}

// 생성 이력 — 모든 양식 공통 단일 테이블(새 양식 추가 시 SQL 테이블 신설 불필요).
model DocSubmission {
  id               String    @id @default(uuid())
  template_id      String
  source_type      String    @default("")                    // 예: "PURCHASE_DECISION" (DB 연동 시)
  source_id        String    @default("")                    // 예: purchase_decisions.id
  seq_no           String    @default("")                    // 채번 필요한 양식용 (예: "호남-26-004")
  input_json       String    @default("{}")                  // 생성 시점 입력 데이터 스냅샷
  render_plan_json String    @default("{}")                  // 해석된 RenderPlan 스냅샷
  output_file_path String    @default("")
  status           String    @default("SUCCESS")              // SUCCESS|FAILED
  error_message     String   @default("")
  generated_by     String
  generated_at     DateTime  @default(now())

  template  DocTemplate @relation(fields: [template_id], references: [id])
  generator User        @relation("DocSubmissionGenerator", fields: [generated_by], references: [id])

  @@index([template_id])
  @@index([source_type, source_id])
  @@map("doc_submissions")
}

// 문서번호 자동 채번용 시퀀스 카운터 (예: scope_key="GIAN-2026").
model DocSequenceCounter {
  scope_key  String   @id
  next_value Int      @default(1)
  updated_at DateTime @updatedAt

  @@map("doc_sequence_counters")
}

// 발주 라우팅 — 승인된 (신청×품목) 수요 단위마다 "어느 경로로 보냈는지" 명시 추적.
// 기존 getProcessedWrItemPairs (source_ward_request_ids × items_json × excluded_items_json
// JSON 블롭 스캔 + `wr_id::item_id` 문자열쌍) 를 대체하는 단일 진실원.
// 대기풀 = 승인된 (wr×item) 중 이 테이블에 status=ACTIVE 행이 없는 것.
model OrderRouting {
  id              String   @id @default(uuid())
  ward_request_id String                                  // 어느 신청에서 나온 승인분인지
  item_id         String?                                 // null = 자유입력 품목
  custom_key      String   @default("")                   // 자유입력 식별 (custom_name 기반)
  route           String                                  // DECISION(구매결의서) | GIAN(기안서) | HOLD(재고보유=발주안함)
  status          String   @default("ACTIVE")             // ACTIVE | RELEASED(보류 해제 → 풀 복귀)
  approved_qty    Decimal  @default(0)                     // 라우팅 시점 승인 팩수 스냅샷
  vendor_id       String?                                  // 라우팅 시점 거래처 (DECISION/GIAN)
  period_label    String   @default("")                   // 신청주기 라벨 스냅샷 (회차 단위 추적·결의서 회차 일치)
  decision_id     String?                                  // DECISION 시 연결된 PurchaseDecision.id
  hold_reason     String   @default("")                   // HOLD 사유
  routed_by       String
  routed_at       DateTime @default(now())
  released_at     DateTime?

  ward_request WardRequest @relation(fields: [ward_request_id], references: [id])

  @@index([ward_request_id, item_id])
  @@index([route, status])
  @@index([status])
  @@map("order_routings")
}

